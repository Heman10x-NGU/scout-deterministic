# Copy to .env — never commit. Benchmark prefers DeepSeek when DEEPSEEK_API_KEY is set.
# Optional: SCOUT_DOTENV_PATH=/path/to/other/.env for a shared secrets file outside the repo.

# ---- DeepSeek (preferred for benchmark agent runs + LLM judge) ----
DEEPSEEK_API_KEY=          # https://platform.deepseek.com/api_keys
DEEPSEEK_BASE_URL=https://api.deepseek.com
SCOUT_BENCH_MODEL=openai/deepseek-v4-flash

# ---- Fallback: MiMo / other OpenAI-compatible ----
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# RANK_MODEL=mimo-v2.5-pro
